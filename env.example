# HYPERFIT Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=sqlite:///./hyperfit.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/hyperfit

# OpenAI API Configuration (for chat assistant)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Configuration (for meal recognition only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Settings
APP_NAME=HYPERFIT
APP_VERSION=1.0.0
DEBUG=True
# SECRET_KEY must be at least 32 characters long and a secure random value
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-secure-random-value-at-least-32-characters-long

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# AI Processing Settings
AI_CONFIDENCE_THRESHOLD=0.7
MAX_IMAGE_DIMENSION=1024

# Optional: External Services
# NUTRITION_API_KEY=your_nutrition_api_key
# WEATHER_API_KEY=your_weather_api_key

# Stripe
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID_MONTHLY=price_monthly_id
STRIPE_PRICE_ID_YEARLY=price_yearly_id
